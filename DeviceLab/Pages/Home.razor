        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task<string?> DecodeQrFrame(byte[] rgba, int width, int height)
    {
        if (rgba is null || width < 1 || height < 1 || width > 480 || height > 480 || rgba.Length != width * height * 4)
            return Task.FromResult<string?>(null);
        try { return Task.FromResult(LocalQrDecoder.DecodeRgba(rgba, width, height)); }
        catch { return Task.FromResult<string?>(null); }
    }

    [JSInvokable]
    public Task OnSceneMetrics(double fps, double average, double frameMs, int samples)
    {
        FpsCurrent = fps; FpsAverage = average; FrameMs = frameMs; FrameSamples = samples;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnMicLevel(int level)
    {
        MicLevel = level; return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnMotion(double? alpha, double? beta, double? gamma, double? x, double? y, double? z)
    {
        MotionAlpha = FormatMetric(alpha, "°"); MotionBeta = FormatMetric(beta, "°"); MotionGamma = FormatMetric(gamma, "°");
        MotionX = FormatMetric(x, ""); MotionY = FormatMetric(y, ""); MotionZ = FormatMetric(z, "");
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnNetworkChanged(bool online, string? connectionType)
    {
        IsOnline = online; ConnectionType = connectionType;
        NetworkStatus = online ? "O navegador reporta que está online." : "Offline · verifique cache publicado do service worker.";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSystemMessage(string message)
    {
        if (message.Contains("fullscreen", StringComparison.OrdinalIgnoreCase)) FullscreenActive = message.EndsWith("on", StringComparison.OrdinalIgnoreCase);
        if (message.Contains("wake", StringComparison.OrdinalIgnoreCase)) WakeLockActive = message.EndsWith("on", StringComparison.OrdinalIgnoreCase);
        if (message.Contains("liberados ao sair", StringComparison.OrdinalIgnoreCase))
        {
            CameraActive = false; MicActive = false; MotionActive = false; SceneActive = false; WakeLockActive = false; GpsBusy = false; MicLevel = 0;
        }
        SystemStatus = message;
        return InvokeAsync(StateHasChanged);
    }

    private static string FormatMetric(double? value, string suffix) => value is null ? "—" : $"{value.Value:F1}{suffix}";

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = StopActiveResources();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        Navigation.LocationChanged -= HandleLocationChanged;
        await StopActiveResources();
        _dotnetRef?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

