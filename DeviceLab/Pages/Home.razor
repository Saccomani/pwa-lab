@page "/"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using DeviceLab.Scanner
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>DeviceLab · bancada do navegador</PageTitle>

<div class="ambient ambient-one" aria-hidden="true"></div>
<div class="ambient ambient-two" aria-hidden="true"></div>

<main class="app-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="DeviceLab início">
            <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>device<span class="brand-accent">lab</span></span>
        </a>
        <div class="topbar-right">
            <span class="connection-pill"><i class="status-dot @(IsOnline ? "online" : "offline")"></i>@(IsOnline ? "Conectado" : "Sem internet")</span>
            <span class="privacy-pill"><span aria-hidden="true">◆</span> Dados no aparelho</span>
        </div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span> LABORATÓRIO DE BOLSO · PWA</p>
            <h1 id="hero-title">Conheça o que seu <span>device</span> consegue fazer.</h1>
            <p class="hero-description">Uma bancada para experimentar recursos do navegador e do aparelho. Cada teste começa no seu clique; os dados ficam aqui.</p>
            <div class="hero-actions">
                <a class="button button-primary" href="#testes">Explorar testes <span aria-hidden="true">↓</span></a>
                <button class="button button-secondary" @onclick='() => OpenTest("webgl")'><span class="play-icon" aria-hidden="true">▶</span> Abrir cena 3D</button>
            </div>
            <div class="hero-footnote"><span class="shield-icon" aria-hidden="true">◈</span> GPS, câmera e microfone não são acionados sem autorização sua.</div>
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="orbital orbital-a"></div>
            <div class="orbital orbital-b"></div>
            <div class="orbital orbital-c"></div>
            <div class="device-orb"><span class="device-orb-inner"></span><span class="device-orb-core"></span></div>
            <div class="float-card float-card-top"><span class="float-icon teal">◎</span><span><b>WebGL</b><small>renderização ao vivo</small></span><i class="status-dot online"></i></div>
            <div class="float-card float-card-bottom"><span class="float-icon violet">⌁</span><span><b>FPS</b><small>medição real</small></span><strong>60</strong></div>
            <div class="art-caption">SENSORES · WEB APIs · PERFORMANCE</div>
        </div>
    </section>

    <section class="quick-stats" aria-label="Resumo do laboratório">
        <div><span class="stat-icon">▦</span><span><strong>15</strong><small>experimentos</small></span></div>
        <div><span class="stat-icon teal">◈</span><span><strong>Local</strong><small>sem envio de dados</small></span></div>
        <div><span class="stat-icon violet">◷</span><span><strong>Ao vivo</strong><small>suporte detectado agora</small></span></div>
        <div class="quick-status"><span class="status-dot @(IsOnline ? "online" : "offline")"></span>@(IsOnline ? "Navegador conectado" : "Modo sem internet")</div>
    </section>

    <section id="testes" class="tests-section" aria-labelledby="tests-title">
        <div class="section-heading">
            <div><p class="eyebrow">ESCOLHA UMA BANCADA</p><h2 id="tests-title">O que vamos testar?</h2><p class="section-intro">Toque em um cartão para abrir os controles. Alguns recursos dependem do navegador, da permissão e de HTTPS.</p></div>
            <button class="button button-stop" @onclick="StopAll" disabled="@(!AnyResourceActive)"><span aria-hidden="true">■</span> Parar testes</button>
        </div>

        <div class="feature-grid">
            @foreach (var item in Tests)
            {
                <button class="feature-card @(SelectedTest == item.Id ? "selected" : "")" @onclick="() => OpenTest(item.Id)" aria-pressed="@(SelectedTest == item.Id)">
                    <span class="feature-top"><span class="feature-icon @item.Tone">@item.Icon</span><span class="feature-tag">@item.Tag</span></span>
                    <span class="feature-title">@item.Title</span>
                    <span class="feature-copy">@item.Description</span>
                    <span class="feature-link">Abrir teste <span aria-hidden="true">↗</span></span>
                </button>
            }
        </div>
    </section>

    @if (SelectedTest is not null)
    {
        <section class="test-panel" aria-live="polite" aria-labelledby="panel-title">
            <div class="panel-heading">
                <div class="panel-title-wrap">
                    <span class="feature-icon @Selected.Tone">@Selected.Icon</span>
                    <div><p class="eyebrow">BANCADA ATIVA</p><h2 id="panel-title" tabindex="-1" @ref="_panelHeading">@Selected.Title</h2></div>
                </div>
                <button class="icon-button" title="Fechar teste" aria-label="Fechar teste" @onclick="CloseTest">×</button>
            </div>

            @if (SelectedTest == "storage")
            {
                <div class="panel-body two-columns">
                    <div class="control-card">
                        <h3>LocalStorage</h3>
                        <p>Grave um texto de teste no armazenamento deste navegador e confira a leitura de volta.</p>
                        <label class="field-label" for="local-value">Valor de teste</label>
                        <input id="local-value" class="text-field" @bind="LocalValue" maxlength="240" autocomplete="off" />
                        <div class="button-row"><button class="button button-primary" @onclick="SaveLocal">Gravar e ler</button><button class="button button-quiet" @onclick="ClearLocal">Apagar teste</button></div>
                        <p class="result-line"><span class="status-dot @(LocalStatus.StartsWith("OK") ? "online" : "muted")"></span>@LocalStatus</p>
                        @if (!string.IsNullOrEmpty(LocalReadback)) { <div class="result-box"><small>Leitura confirmada</small><strong>@LocalReadback</strong></div> }
                    </div>
                    <div class="info-card"><span class="info-kicker">SEM NUVEM</span><h3>O que fica salvo?</h3><p>Somente a chave <code>devicelab.demo</code> e o texto que você informar. O botão “Apagar teste” remove essa chave.</p><p class="muted-copy">Armazenamento persistente pode ser limpo nas configurações do navegador. Não use dados sensíveis neste teste.</p></div>
                </div>
            }
            else if (SelectedTest == "gps")
            {
                <div class="panel-body two-columns">
                    <div class="control-card">
                        <h3>Posição do aparelho</h3><p>Uma leitura única da localização atual; nada é gravado ou enviado.</p>
                        <button class="button button-primary" @onclick="ReadLocation" disabled="@GpsBusy">@(GpsBusy ? "Consultando…" : "Solicitar localização")</button>
                        <p class="result-line"><span class="status-dot @(GpsStatus.StartsWith("Localização recebida") ? "online" : "muted")"></span>@GpsStatus</p>
                        @if (GpsLatitude is not null)
                        {
                            <div class="metric-row"><div class="metric-tile"><small>Latitude</small><strong>@GpsLatitude.Value.ToString("F6")</strong></div><div class="metric-tile"><small>Longitude</small><strong>@GpsLongitude!.Value.ToString("F6")</strong></div><div class="metric-tile"><small>Precisão informada</small><strong>± @GpsAccuracy!.Value.ToString("F0") m</strong></div></div>
                        }
                    </div>
                    <div class="info-card"><span class="info-kicker">CLIQUE DELIBERADO</span><h3>Permissão e precisão</h3><p>O navegador pergunta antes do primeiro acesso. O resultado pode vir de GPS, Wi‑Fi ou rede celular; a precisão varia.</p><p class="muted-copy">Se o teste for negado ou indisponível, confira a permissão deste site e os serviços de localização do aparelho. Use HTTPS fora de localhost.</p></div>
                </div>
            }
            else if (SelectedTest == "camera")
            {
                <div class="panel-body two-columns camera-layout">
                    <div class="camera-box"><video id="cameraView" playsinline autoplay muted aria-label="Prévia local da câmera"></video><div class="camera-placeholder"><span class="camera-placeholder-icon">▣</span><strong>Prévia da câmera</strong><small>A imagem permanece no aparelho e não é enviada.</small></div><div class="scan-frame" aria-hidden="true"><i></i><i></i><i></i><i></i><span></span></div></div>
                    <div class="control-card">
                        <h3>Câmera e leitor QR</h3><p>A câmera só abre depois deste clique. O leitor ZXing.Net roda localmente em WebAssembly, sem mandar a imagem para um servidor.</p>
                        <div class="button-row"><button class="button button-primary" @onclick="StartCamera" disabled="@CameraActive">Abrir câmera</button><button class="button button-quiet" @onclick="StopCamera" disabled="@(!CameraActive)">Parar e liberar</button></div>
                        <div class="button-row photo-capture-row"><button class="button button-secondary" @onclick="CapturePhoto" disabled="@(!CameraActive)">Capturar foto</button><span class="photo-status">@PhotoStatus</span></div>
                        @if (!string.IsNullOrEmpty(CapturedPhotoDataUrl))
                        {
                            <div class="captured-photo-card">
                                <img src="@CapturedPhotoDataUrl" alt="Foto capturada nesta bancada" />
                                <div class="captured-photo-actions"><span>Foto temporária nesta sessão · somente neste aparelho</span><a class="button button-quiet" href="@CapturedPhotoDataUrl" download="devicelab-foto.jpg">Baixar foto</a><button class="button button-quiet" @onclick="ClearCapturedPhoto">Apagar foto</button></div>
                            </div>
                        }
                        <p class="result-line"><span class="status-dot @(CameraActive ? "online" : "muted")"></span>@CameraStatus</p>
                        @if (!string.IsNullOrEmpty(QrResult)) { <div class="result-box"><small>QR lido na sessão atual</small><strong class="break-word">@QrResult</strong></div> }
                        <div class="qr-demo-card"><div class="qr-demo-image"><img id="demoQrImage" src="qr-demo.svg" alt="QR de amostra local com o texto DEVICE-LAB-LOCAL-DEMO" /></div><div class="qr-demo-copy"><span class="info-kicker">LEITURA DE AMOSTRA</span><strong>Teste sem abrir a câmera</strong><small>O mesmo decodificador local lê este QR de demonstração.</small><button class="button button-secondary" @onclick="ScanQrSample">Ler QR de amostra</button></div></div>
                        <p class="privacy-note">QRs são exibidos como texto nesta página. Um código lido nunca abre um link automaticamente.</p>
                    </div>
                </div>
            }
            else if (SelectedTest == "notifications")
            {
                <div class="panel-body two-columns">
                    <div class="control-card"><h3>Notificação local</h3><p>Solicite permissão e exiba uma notificação de teste a partir do service worker deste app.</p><button class="button button-primary" @onclick="SendLocalNotification">Permitir e mostrar notificação local</button><p class="result-line"><span class="status-dot @(NotificationStatus.StartsWith("Notificação exibida") ? "online" : "muted")"></span>@NotificationStatus</p><p class="muted-copy">Em dispositivos móveis, o navegador pode exigir PWA instalado e HTTPS. A escolha de permissão é controlada pelo sistema.</p></div>
                    <div class="info-card push-card"><span class="info-kicker">OUTRO RECURSO</span><h3>Push remoto</h3><p>Push precisa de um serviço de envio, inscrição do dispositivo e chaves de aplicação. Este projeto não tem servidor, credenciais nem envio configurado.</p><div class="push-state"><span class="status-dot muted"></span><span><b>Não configurado</b><small>Nenhuma conexão de push será criada.</small></span></div></div>
                </div>
            }
            else if (SelectedTest == "webgl")
            {
                <div class="panel-body benchmark-body">
                    <div class="scene-card"><canvas id="webglCanvas" aria-label="Cena 3D WebGL de teste"></canvas><div class="scene-overlay"><span class="live-badge"><i></i> RENDER AO VIVO</span><span class="scene-label">CENA WEBGL · CUBO DE REFERÊNCIA</span></div><div class="scene-fallback">WebGL não está disponível neste navegador.</div></div>
                    <div class="bench-controls">
                        <div class="fps-main"><div><span class="info-kicker">FPS OBSERVADO · ÚLTIMO SEGUNDO</span><strong>@FpsCurrent.ToString("F0")</strong><small>alvo visual: 60 FPS · sem garantia universal</small></div><div class="fps-gauge" style="--gauge:@Math.Clamp(FpsCurrent / 60d * 100d, 0d, 100d).ToString("F0")%"><span>@(FpsCurrent >= 55 ? "RÁPIDO" : FpsCurrent >= 28 ? "FLUIDO" : "CARREGADO")</span></div></div>
                        <div class="metric-row"><div class="metric-tile"><small>Média da sessão</small><strong>@FpsAverage.ToString("F1") FPS</strong></div><div class="metric-tile"><small>Tempo médio por quadro</small><strong>@FrameMs.ToString("F1") ms</strong></div><div class="metric-tile"><small>Quadros medidos</small><strong>@FrameSamples</strong></div></div>
                        <div class="load-control"><div class="field-heading"><label for="load-level">Carga do shader</label><span>@WorkloadLabel</span></div><input id="load-level" type="range" min="0" max="12" step="1" @bind="Workload" @bind:event="oninput" @onchange="ApplyWorkload"/><div class="range-labels"><span>Leve</span><span>Mais intenso</span></div></div>
                        <div class="button-row"><button class="button button-primary" @onclick="StartScene" disabled="@SceneActive">Iniciar cena</button><button class="button button-quiet" @onclick="StopScene" disabled="@(!SceneActive)">Parar cena</button></div>
                        <p class="privacy-note">O número vem de requestAnimationFrame no canvas e varia com GPU, tela, economia de energia, temperatura e outras abas. Carga alta pode aquecer e consumir bateria.</p>
                        <p class="result-line"><span class="status-dot @(SceneActive ? "online" : "muted")"></span>@SceneStatus</p>
                    </div>
                </div>
            }
            else if (SelectedTest == "indexeddb")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Banco local IndexedDB</h3><p>Grave e leia uma amostra simples no banco local desta origem.</p><div class="button-row"><button class="button button-primary" @onclick="SaveIndexedDb">Gravar amostra</button><button class="button button-quiet" @onclick="ReadIndexedDb">Ler amostra</button><button class="button button-quiet" @onclick="ClearIndexedDb">Apagar amostra</button></div><p class="result-line">@IndexedDbStatus</p><div class="result-box"><small>Registro de demonstração</small><strong>@IndexedDbValue</strong></div></div><div class="info-card"><span class="info-kicker">BANCO DO NAVEGADOR</span><h3>Armazenamento estruturado</h3><p>IndexedDB funciona sem um servidor de dados. A amostra é escrita somente após você tocar em “Gravar amostra”.</p><p class="muted-copy">O espaço e a persistência podem variar por navegador e pelas configurações do usuário.</p></div></div>
            }
            else if (SelectedTest == "offline")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Conectividade e PWA</h3><p class="result-line"><span class="status-dot @(IsOnline ? "online" : "offline")"></span>@NetworkStatus</p><div class="metric-row"><div class="metric-tile"><small>Online agora</small><strong>@(IsOnline ? "Sim" : "Não")</strong></div><div class="metric-tile"><small>Tipo efetivo</small><strong>@(ConnectionType ?? "Não informado")</strong></div><div class="metric-tile"><small>Service worker</small><strong>@ServiceWorkerStatus</strong></div></div><button class="button button-secondary" @onclick="RefreshPwaStatus">Atualizar status PWA</button></div><div class="info-card"><span class="info-kicker">CACHE OFFLINE</span><h3>Reabra depois do primeiro carregamento</h3><p>O template Blazor PWA mantém os arquivos publicados no cache do service worker. A primeira carga precisa de rede.</p><p class="muted-copy">Durante <code>dotnet run</code> o service worker de desenvolvimento não ativa o cache offline. Faça o teste com o pacote publicado conforme o README.</p><div class="push-state"><span class="status-dot @(IsInstalled ? "online" : "muted")"></span><span><b>@(IsInstalled ? "Modo instalado" : "Modo navegador")</b><small>Instalação depende do navegador e do sistema.</small></span></div></div></div>
            }
            else if (SelectedTest == "microphone")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Nível de áudio ambiente</h3><p>Ative o microfone para ler o nível do sinal enquanto esta tela fica aberta. O áudio não é gravado.</p><div class="audio-meter" role="meter" aria-label="Nível de áudio" aria-valuenow="@MicLevel" aria-valuemin="0" aria-valuemax="100"><span style="width:@MicLevel%"></span></div><div class="field-heading"><span>@MicLevel% de nível</span><span>@MicStatus</span></div><div class="button-row"><button class="button button-primary" @onclick="StartMicrophone" disabled="@MicActive">Ativar microfone</button><button class="button button-quiet" @onclick="StopMicrophone" disabled="@(!MicActive)">Parar e liberar</button></div></div><div class="info-card"><span class="info-kicker">SEM GRAVAÇÃO</span><h3>Processamento transitório</h3><p>O código calcula apenas o volume aproximado no próprio navegador. Nenhum arquivo de áudio é criado ou transmitido.</p><p class="muted-copy">O pedido do sistema aparece somente quando você toca no botão. HTTPS e permissão concedida são necessários.</p></div></div>
            }
            else if (SelectedTest == "motion")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Orientação e movimento</h3><p>Mostre os valores que o dispositivo disponibilizar enquanto a sessão está ativa.</p><div class="metric-row"><div class="metric-tile"><small>Alpha / bússola</small><strong>@MotionAlpha</strong></div><div class="metric-tile"><small>Beta</small><strong>@MotionBeta</strong></div><div class="metric-tile"><small>Gamma</small><strong>@MotionGamma</strong></div></div><div class="metric-row"><div class="metric-tile"><small>Aceleração X</small><strong>@MotionX</strong></div><div class="metric-tile"><small>Aceleração Y</small><strong>@MotionY</strong></div><div class="metric-tile"><small>Aceleração Z</small><strong>@MotionZ</strong></div></div><div class="button-row"><button class="button button-primary" @onclick="StartMotion" disabled="@MotionActive">Ativar sensores</button><button class="button button-quiet" @onclick="StopMotion" disabled="@(!MotionActive)">Parar sensores</button></div><p class="result-line">@MotionStatus</p></div><div class="info-card"><span class="info-kicker">SENSORES DO SISTEMA</span><h3>Compatibilidade varia</h3><p>Alguns navegadores exigem HTTPS e uma confirmação extra. Valores ausentes podem significar que o sensor não existe, está bloqueado ou não é exposto.</p><p class="muted-copy">A leitura para quando você fecha este teste, muda de página ou usa “Parar testes”.</p></div></div>
            }
            else if (SelectedTest == "clipboard")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Área de transferência</h3><p>Copie um texto de teste ou leia o conteúdo atual. Ler pode mostrar dados pessoais que você copiou antes.</p><label class="field-label" for="clipboard-value">Texto para copiar</label><input id="clipboard-value" class="text-field" @bind="ClipboardValue" maxlength="240" autocomplete="off"/><div class="button-row"><button class="button button-primary" @onclick="CopyClipboard">Copiar texto</button><button class="button button-quiet" @onclick="ReadClipboard">Ler clipboard</button></div><p class="result-line">@ClipboardStatus</p>@if (!string.IsNullOrEmpty(ClipboardReadback)){<div class="result-box"><small>Conteúdo local lido</small><strong class="break-word">@ClipboardReadback</strong></div>}</div><div class="info-card"><span class="info-kicker">ACESSO SOB DEMANDA</span><h3>Nada acontece sozinho</h3><p>O navegador controla o acesso e pode exigir gesto, permissão ou HTTPS. O conteúdo não sai desta página.</p><p class="muted-copy">Para evitar expor algo acidentalmente, confira o botão antes de ler a área de transferência.</p></div></div>
            }
            else if (SelectedTest == "sharing")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Compartilhamento do sistema</h3><p>Abra a folha de compartilhamento nativa, quando disponível, com um texto neutro sobre o DeviceLab.</p><button class="button button-primary" @onclick="ShareDemo">Compartilhar DeviceLab</button><p class="result-line">@ShareStatus</p></div><div class="info-card"><span class="info-kicker">SEM DESTINATÁRIO PRÉ-SELECIONADO</span><h3>Você escolhe o destino</h3><p>O navegador mostra os destinos disponíveis. Nenhum arquivo ou dado privado é anexado pelo teste.</p></div></div>
            }
            else if (SelectedTest == "files")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Seleção de arquivo local</h3><p>Escolha um arquivo para ler apenas o nome, tipo e tamanho; o conteúdo não é enviado nem salvo.</p><label class="file-picker"><span class="file-picker-icon">＋</span><span><b>Escolher um arquivo</b><small>O seletor do aparelho abre após seu toque</small></span><InputFile OnChange="HandleFileChange" /></label>@if(FileInfo is not null){<div class="metric-row"><div class="metric-tile"><small>Nome</small><strong class="break-word">@FileInfo.Name</strong></div><div class="metric-tile"><small>Tamanho</small><strong>@FileInfo.SizeLabel</strong></div><div class="metric-tile"><small>Tipo</small><strong>@FileInfo.ContentType</strong></div></div>}</div><div class="info-card"><span class="info-kicker">ESCOPO LIMITADO</span><h3>Sem upload</h3><p>Este teste não lê bytes nem envia o arquivo. A seleção termina aqui e pode ser trocada quando você quiser.</p><p class="muted-copy">APIs avançadas de sistema de arquivos aparecem em poucos navegadores; não são necessárias para escolher um arquivo.</p></div></div>
            }
            else if (SelectedTest == "system")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Tela e atividade</h3><p>Teste tela cheia e mantenha a tela ativa temporariamente, se o navegador liberar.</p><div class="button-row"><button class="button button-primary" @onclick="ToggleFullscreen">@(FullscreenActive ? "Sair da tela cheia" : "Entrar em tela cheia")</button><button class="button button-quiet" @onclick="ToggleWakeLock">@(WakeLockActive ? "Liberar tela ativa" : "Manter tela ativa")</button></div><p class="result-line">@SystemStatus</p><p class="muted-copy">O bloqueio de suspensão é liberado ao ocultar a página ou sair do app.</p></div><div class="info-card"><span class="info-kicker">SOB CONTROLE DO NAVEGADOR</span><h3>Permissões temporárias</h3><p>Fullscreen e Wake Lock variam por navegador, dispositivo, orientação e estado da tela. A experiência pode pedir gesto e não permanece após sair da página.</p></div></div>
            }
            else if (SelectedTest == "haptics")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Vibração</h3><p>Envie um padrão curto ao aparelho, quando a API estiver disponível.</p><button class="button button-primary" @onclick="Vibrate">Vibrar por um instante</button><p class="result-line">@VibrationStatus</p></div><div class="info-card"><span class="info-kicker">RESPOSTA HÁPTICA</span><h3>Não disponível em todo lugar</h3><p>iOS/Safari e alguns navegadores não expõem a API. Um toque sem resposta pode significar suporte ausente, modo silencioso ou vibração desativada.</p></div></div>
            }
            else if (SelectedTest == "capabilities")
            {
                <div class="panel-body two-columns"><div class="control-card"><h3>Recursos detectados</h3><p>Disponibilidade observada nesta origem e nesta sessão. Detectar não abre dispositivos nem solicita acesso.</p><div class="capability-grid">@foreach(var cap in Capabilities){<div class="capability-row"><span class="status-dot @(cap.Value ? "online" : "muted")"></span><span>@cap.Label</span><strong>@(cap.Value ? "Disponível" : "Ausente")</strong></div>}</div><p class="muted-copy">WebUSB, WebSerial, Bluetooth e outros recursos avançados dependem do navegador e do hardware; nenhum pareamento é iniciado aqui.</p></div><div class="info-card"><span class="info-kicker">DETECÇÃO, SEM COLETA</span><h3>Uma fotografia do navegador</h3><p>O relatório mostra somente se determinadas interfaces existem. Ele não tenta identificar modelo, número de série ou dispositivos próximos.</p><button class="button button-secondary" @onclick="RefreshCapabilities">Atualizar recursos</button></div></div>
            }
        </section>
    }

    <footer class="footer">
